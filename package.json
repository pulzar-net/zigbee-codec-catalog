  "dependencies": {
    "buffer": "6.0.3",
    "esbuild": "0.28.2",
    "events": "3.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "quickjs-emscripten": "0.31.0",
    "typescript": "7.0.2",
    "zigbee-herdsman-converters": "26.135.0"
  }
}
